---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Process headings to render LaTeX in TOC
const processedHeadings = headings.map((heading) => {
  let processedText = heading.text;
  
  // Handle inline math $...$
  processedText = processedText.replace(/\$([^$]+)\$/g, (match, formula) => {
    // Create a span with KaTeX class for inline math
    return `<span class="katex-inline" data-formula="${formula}">${formula}</span>`;
  });
  
  // Handle block math $$...$$
  processedText = processedText.replace(/\$\$([^$]+)\$\$/g, (match, formula) => {
    // Create a span with KaTeX class for block math
    return `<span class="katex-block" data-formula="${formula}">${formula}</span>`;
  });
  
  return {
    ...heading,
    text: processedText,
  };
});

/* Sections only, matching the reference's "On this page" list. Including h3
   put ~25 entries per article (53 in the longest) in a 17rem rail, which then
   grew taller than the space left above the footer and got pushed up under
   the header at the end of the page. */
const filteredHeadings = processedHeadings.filter((h) => h.depth === 2);
---

{filteredHeadings.length > 0 && (
  <aside class="toc-sidebar">
    <nav class="toc-container">
      <div class="toc-header">
        <span class="toc-title">目录</span>
      </div>
      <ul class="toc-list">
        {filteredHeadings.map((heading) => (
          <li class={`toc-item toc-depth-${heading.depth}`}>
            <a href={`#${heading.slug}`} data-slug={heading.slug} class="toc-link" set:html={heading.text}>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}

<style>
  /* The rail handles the sticky offset, so this only decides visibility. It used
     to carry its own `position: sticky; top: 2rem`, which fought the rail's
     offset and parked the list under the header. */
  .toc-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .toc-sidebar {
      display: block;
    }
  }

  /* The rail is unframed: the reference's TOC is a bordered list floating on
     the page background, not a card. */
  .toc-container {
    padding: 0;
  }

  /* Section label: tracked small caps, no rule under it. */
  .toc-header {
    margin-bottom: 0.75rem;
  }

  .toc-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: hsl(var(--fg-muted));
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1rem;
    border-left: 1px solid hsl(var(--line));
  }

  .toc-item {
    margin: 0;
    position: relative;
  }

  .toc-depth-2 {
    padding-left: 0;
  }


  .toc-link {
    display: block;
    padding: 0.25rem 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: hsl(var(--fg-muted));
    transition: color 0.15s;
    text-decoration: none;
  }

  .toc-link:hover {
    color: hsl(var(--brand));
  }

  /* Scroll-spy state is carried by colour alone; the rail stays put. */
  .toc-link.active {
    color: hsl(var(--fg));
    font-weight: 500;
  }

  .toc-sidebar::-webkit-scrollbar {
    width: 4px;
  }

  .toc-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-sidebar::-webkit-scrollbar-thumb {
    background-color: hsl(var(--line));
    border-radius: 2px;
  }

  /* KaTeX styles for TOC */
  .katex-inline {
    font-family: 'KaTeX_Main', 'Times New Roman', serif;
    font-size: 0.9em;
  }

  .katex-block {
    display: block;
    font-family: 'KaTeX_Main', 'Times New Roman', serif;
    font-size: 0.85em;
    text-align: center;
    margin: 0.25rem 0;
  }
</style>

<script>
  function initTocHighlight() {
    const tocSidebar = document.querySelector<HTMLElement>('.toc-sidebar');
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const headingElements: HTMLElement[] = [];
    
    if (tocLinks.length === 0 || !tocSidebar) return;

    tocLinks.forEach((link) => {
      const slug = link.dataset.slug;
      if (slug) {
        const heading = document.getElementById(slug);
        if (heading) {
          headingElements.push(heading);
        }
      }
    });

    if (headingElements.length === 0) return;

    function highlightToc() {
      const scrollTop = window.scrollY;
      
      let currentHeading: HTMLElement | null = null;
      
      for (const heading of headingElements) {
        const rect = heading.getBoundingClientRect();
        const headingTop = rect.top + scrollTop;
        
        if (headingTop <= scrollTop + 120) {
          currentHeading = heading;
        }
      }

      if (!currentHeading && headingElements.length > 0) {
        const firstHeadingTop = headingElements[0].getBoundingClientRect().top + scrollTop;
        if (scrollTop < firstHeadingTop) {
          currentHeading = headingElements[0];
        }
      }

      tocLinks.forEach((link) => {
        link.classList.remove('active');
        if (currentHeading && link.dataset.slug === currentHeading.id) {
          link.classList.add('active');
          
          const sidebar = document.querySelector('.toc-sidebar');
          if (sidebar) {
            const linkRect = link.getBoundingClientRect();
            const sidebarRect = sidebar.getBoundingClientRect();
            
            if (linkRect.top < sidebarRect.top || linkRect.bottom > sidebarRect.bottom) {
              link.scrollIntoView({ block: 'center', behavior: 'smooth' });
            }
          }
        }
      });
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
                highlightToc();
          ticking = false;
        });
        ticking = true;
      }
    });

    // 初始化
    highlightToc();

    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = link.dataset.slug;
        if (slug) {
          const target = document.getElementById(slug);
          if (target) {
            const offsetTop = target.getBoundingClientRect().top + window.scrollY - 80;
            window.scrollTo({ top: offsetTop, behavior: 'smooth' });
            history.pushState(null, '', `#${slug}`);
          }
        }
      });
    });

    // Render LaTeX in TOC if KaTeX is available
    const katex = (window as any).katex;
    if (katex) {
      document.querySelectorAll('.katex-inline, .katex-block').forEach((element) => {
        const formula = element.getAttribute('data-formula');
        if (formula) {
          try {
            const isBlock = element.classList.contains('katex-block');
            const rendered = katex.renderToString(formula, {
              displayMode: isBlock,
              throwOnError: false,
            });
            element.innerHTML = rendered;
          } catch (e) {
            // Fallback to plain text if rendering fails
            element.textContent = formula;
          }
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTocHighlight);
  } else {
    initTocHighlight();
  }

  document.addEventListener('astro:page-load', initTocHighlight);
</script>