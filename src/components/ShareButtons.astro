---
interface Props {
  title: string;
  description?: string;
  url?: string;
  class?: string;
}

const { title, description = '', url, class: className = '' } = Astro.props;

const pageUrl = url || Astro.url.href;
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(title);
const encodedDesc = encodeURIComponent(description);
---

<div class={`share-buttons ${className}`} data-share-root data-share-url={pageUrl} data-share-title={title} data-share-desc={description}>
  <span class="share-label">分享</span>
  <div class="share-icons">
    <button
      type="button"
      class="share-btn share-btn-wechat"
      data-share-wechat
      aria-label="分享到微信"
      title="分享到微信"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M8.5 4C4.36 4 1 6.69 1 10c0 1.92 1.14 3.62 2.9 4.71L3 17l2.5-1.32c.6.12 1.22.18 1.86.21-.18-.59-.27-1.21-.27-1.84 0-3.31 3.13-6 7-6 .36 0 .71.02 1.05.07C14.61 5.45 11.84 4 8.5 4zm-2.5 3a1 1 0 110 2 1 1 0 010-2zm4 0a1 1 0 110 2 1 1 0 010-2z"/>
        <path d="M22.5 14c0-2.76-2.91-5-6.5-5s-6.5 2.24-6.5 5 2.91 5 6.5 5c.6 0 1.18-.06 1.72-.18L20 20l-.7-1.91C21.32 17.13 22.5 15.65 22.5 14zm-9-1.5a.75.75 0 110 1.5.75.75 0 010-1.5zm5 0a.75.75 0 110 1.5.75.75 0 010-1.5z"/>
      </svg>
      <span>微信</span>
    </button>

    <a
      class="share-btn share-btn-weibo"
      href={`https://service.weibo.com/share/share.php?url=${encodedUrl}&title=${encodedTitle}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="分享到微博"
      title="分享到微博"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M10.1 21.1c-4.4.4-8.1-1.6-8.4-4.5-.3-2.9 3.1-5.5 7.5-5.9 4.4-.4 8.1 1.6 8.4 4.5.3 2.9-3.1 5.5-7.5 5.9zm-.3-2.4c1.8-.1 3.2-1.2 3.1-2.4-.1-1.2-1.7-2-3.5-1.9-1.8.2-3.2 1.2-3.1 2.4.1 1.2 1.7 2 3.5 1.9zm-1-2c-.5.1-1-.2-1-.6-.1-.4.2-.8.7-.9.5-.1 1 .1 1 .5.1.5-.2.9-.7 1zm9.3-7.4c-.4-.1-.6-.2-.4-.6.4-1 .5-1.8 0-2.4-.8-1.1-3.1-1-5.7 0 0 0-.8.4-.6-.3.4-1.2.3-2.2-.2-2.8-1.1-1.3-4.1 0-6.7 2.8C2.6 7.2 1.5 8.5 1.5 9.7c0 2.2 3 3.5 6.5 3.5.3 0 .5 0 .5.3 0 .2-.1.4-.1.6-.1.3.1.5.4.4 2.3-.7 4.1-.3 4.6 1 .3.9-.3 1.8-1.4 2.5-.3.2-.5.3-.5.6 0 .6 1.7.6 3.2-.2 1.9-1 2.7-2.4 2.5-3.6-.1-1-1-1.5-2.2-1.9zm-1-3c-.2 0-.4-.2-.4-.4 0-1-1.1-1.6-2.5-1.6-.3 0-.5-.2-.5-.4 0-.2.2-.4.5-.4 1.8 0 3.2.9 3.2 2.4.1.2-.1.4-.3.4z"/>
        <path d="M19.7 4.3c-2.4-2.7-6.3-3-9-.7-.3.2-.3.6-.1.9.2.3.6.3.9.1 2.1-1.8 5.2-1.6 7.1.6 1.9 2.1 2.1 5.2.3 7.4-.2.3-.2.7.1.9.3.2.7.2.9-.1 2.2-2.7 2-6.4-.2-9.1z"/>
      </svg>
      <span>微博</span>
    </a>

    <a
      class="share-btn share-btn-twitter"
      href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="分享到 X / Twitter"
      title="分享到 X / Twitter"
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      <span>X</span>
    </a>

    <button
      type="button"
      class="share-btn share-btn-link"
      data-share-copy
      aria-label="复制链接"
      title="复制链接"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>
      </svg>
      <span data-share-copy-label>复制链接</span>
    </button>

    <button
      type="button"
      class="share-btn share-btn-native"
      data-share-native
      aria-label="更多分享"
      title="更多分享"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="18" cy="5" r="3"/>
        <circle cx="6" cy="12" r="3"/>
        <circle cx="18" cy="19" r="3"/>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
      </svg>
      <span>更多</span>
    </button>
  </div>
</div>

<!-- WeChat QR modal: the user scans the QR to share into a WeChat chat. -->
<div class="share-wechat-modal" data-wechat-modal hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="wechat-modal-title">
  <div class="share-wechat-backdrop" data-wechat-close></div>
  <div class="share-wechat-card">
    <button type="button" class="share-wechat-close" data-wechat-close aria-label="关闭">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3 id="wechat-modal-title" class="share-wechat-title">分享到微信</h3>
    <p class="share-wechat-desc">用微信扫一扫，将页面分享给朋友或朋友圈</p>
    <div class="share-wechat-qr" data-wechat-qr></div>
    <p class="share-wechat-tip">点击图片保存，或长按识别二维码</p>
  </div>
</div>

<style>
  .share-buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 1.25rem 0;
    margin: 2.5rem 0 1.5rem;
    border-top: 1px solid var(--notion-border);
  }

  .share-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--notion-text-secondary);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .share-icons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4375rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--notion-text-secondary);
    background-color: var(--notion-bg-secondary);
    border: 1px solid var(--notion-border);
    border-radius: 0.5rem;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s, transform 0.1s;
    user-select: none;
  }

  .share-btn:hover {
    color: var(--notion-text);
    background-color: var(--notion-bg-hover);
    border-color: var(--notion-text-secondary);
  }

  .share-btn:active {
    transform: scale(0.97);
  }

  .share-btn svg {
    flex-shrink: 0;
  }

  .share-btn-wechat:hover {
    color: #07c160;
    border-color: #07c160;
  }

  .share-btn-weibo:hover {
    color: #e6162d;
    border-color: #e6162d;
  }

  .share-btn-twitter:hover {
    color: #000;
    border-color: #000;
  }

  :global(.dark) .share-btn-twitter:hover {
    color: #fff;
    border-color: #fff;
  }

  .share-btn-link.copied,
  .share-btn-link[data-copied='true'] {
    color: #07c160;
    border-color: #07c160;
    background-color: rgba(7, 193, 96, 0.1);
  }

  .share-btn-native {
    display: none;
  }

  @media (max-width: 640px) {
    .share-btn span {
      display: none;
    }
    .share-btn {
      padding: 0.5rem;
    }
  }

  /* WeChat modal */
  .share-wechat-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .share-wechat-modal[hidden] {
    display: none;
  }
  .share-wechat-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }
  .share-wechat-card {
    position: relative;
    width: min(360px, calc(100vw - 2rem));
    padding: 1.75rem 1.5rem 1.5rem;
    background: var(--notion-bg);
    border-radius: 0.75rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    text-align: center;
  }
  .share-wechat-close {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.875rem;
    height: 1.875rem;
    color: var(--notion-text-secondary);
    background: transparent;
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .share-wechat-close:hover {
    background: var(--notion-bg-hover);
  }
  .share-wechat-title {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--notion-text);
  }
  .share-wechat-desc {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    color: var(--notion-text-secondary);
    line-height: 1.5;
  }
  .share-wechat-qr {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 0.75rem;
    width: 220px;
    height: 220px;
    padding: 0.5rem;
    background: #fff;
    border-radius: 0.5rem;
    border: 1px solid var(--notion-border);
  }
  .share-wechat-qr canvas,
  .share-wechat-qr img,
  .share-wechat-qr svg {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }
  .share-wechat-tip {
    margin: 0;
    font-size: 0.75rem;
    color: var(--notion-text-secondary);
  }
</style>

<script>
  // Lazy-load QR generation. We bundle qrcode-generator (small, no deps)
  // only when the user actually clicks the WeChat share button.
  let qrLibPromise: Promise<any> | null = null;
  async function loadQrLib() {
    if (!qrLibPromise) {
      qrLibPromise = import('qrcode-generator');
    }
    return qrLibPromise;
  }

  function getMeta(name: string) {
    const el = document.querySelector(`meta[property="${name}"]`) as HTMLMetaElement | null;
    return el?.content || '';
  }

  function readShareData(root: HTMLElement) {
    return {
      url: root.dataset.shareUrl || location.href,
      title: root.dataset.shareTitle || document.title,
      desc: root.dataset.shareDesc || getMeta('og:description'),
    };
  }

  function showToast(message: string) {
    let toast = document.getElementById('share-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'share-toast';
      toast.style.cssText = [
        'position:fixed',
        'left:50%',
        'bottom:80px',
        'transform:translateX(-50%)',
        'background:rgba(0,0,0,0.85)',
        'color:#fff',
        'padding:8px 16px',
        'border-radius:6px',
        'font-size:14px',
        'z-index:200',
        'pointer-events:none',
        'opacity:0',
        'transition:opacity .2s',
      ].join(';');
      document.body.appendChild(toast);
    }
    toast.textContent = message;
    toast.style.opacity = '1';
    window.clearTimeout((showToast as any)._t);
    (showToast as any)._t = window.setTimeout(() => {
      toast!.style.opacity = '0';
    }, 1800);
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {}
    // Fallback for non-secure contexts (e.g. http://localhost)
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.cssText = 'position:fixed;left:-9999px;top:-9999px;opacity:0;';
    document.body.appendChild(ta);
    ta.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {}
    document.body.removeChild(ta);
    return ok;
  }

  function openWechatModal(root: HTMLElement) {
    const modal = document.querySelector('[data-wechat-modal]') as HTMLElement | null;
    if (!modal) return;
    const qrBox = modal.querySelector('[data-wechat-qr]') as HTMLElement | null;
    if (!qrBox) return;
    qrBox.innerHTML = '';
    const { url } = readShareData(root);
    loadQrLib()
      .then((qrcode: any) => {
        // type 0 = auto-detect smallest version that fits.
        const qr = qrcode(0, 'M');
        qr.addData(url);
        qr.make();
        qrBox.innerHTML = qr.createSvgTag({
          cellSize: 6,
          margin: 2,
        });
      })
      .catch(() => {
        qrBox.textContent = '二维码加载失败';
      });
    modal.hidden = false;
    modal.setAttribute('aria-hidden', 'false');
  }

  function closeWechatModal() {
    const modal = document.querySelector('[data-wechat-modal]') as HTMLElement | null;
    if (!modal) return;
    modal.hidden = true;
    modal.setAttribute('aria-hidden', 'true');
  }

  function init() {
    const root = document.querySelector('[data-share-root]') as HTMLElement | null;
    if (!root) return;

    // WeChat button
    const wxBtn = root.querySelector('[data-share-wechat]');
    wxBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      openWechatModal(root);
    });

    // Copy link button
    const copyBtn = root.querySelector('[data-share-copy]') as HTMLButtonElement | null;
    copyBtn?.addEventListener('click', async (e) => {
      e.preventDefault();
      const { url } = readShareData(root);
      const ok = await copyText(url);
      if (ok) {
        const label = copyBtn.querySelector('[data-share-copy-label]');
        const original = label?.textContent || '复制链接';
        if (label) label.textContent = '已复制 ✓';
        copyBtn.dataset.copied = 'true';
        copyBtn.classList.add('copied');
        showToast('链接已复制');
        window.setTimeout(() => {
          if (label) label.textContent = original;
          copyBtn.classList.remove('copied');
          delete copyBtn.dataset.copied;
        }, 1800);
      } else {
        showToast('复制失败，请手动选择链接');
      }
    });

    // Native share (mobile / supported browsers)
    const nativeBtn = root.querySelector('[data-share-native]') as HTMLButtonElement | null;
    if (nativeBtn) {
      if ((navigator as any).share) {
        nativeBtn.style.display = '';
        nativeBtn.addEventListener('click', async (e) => {
          e.preventDefault();
          const { url, title, desc } = readShareData(root);
          try {
            await (navigator as any).share({ url, title, text: desc || title });
          } catch {
            /* user cancelled */
          }
        });
      } else {
        nativeBtn.remove();
      }
    }

    // Modal close handlers
    document.querySelectorAll('[data-wechat-close]').forEach((el) => {
      el.addEventListener('click', closeWechatModal);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeWechatModal();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
