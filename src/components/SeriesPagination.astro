---
interface PostRef {
  id: string;
  data: {
    title: string;
    series?: string;
    seriesOrder?: number;
  };
}

interface Props {
  series: string;
  currentSlug: string;
  posts: PostRef[];
}

const { series, currentSlug, posts } = Astro.props;

const seriesPosts = posts
  .filter((post) => post.data.series === series)
  .sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0));

const currentIndex = seriesPosts.findIndex((post) => post.id === currentSlug);
const prevPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;
const nextPost = currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : null;
---

{(prevPost || nextPost) && (
  <nav class="series-pagination">
    <div class="pagination-container">
      {prevPost ? (
        <a href={`/blog/${prevPost.id}`} class="pagination-link prev">
          <span class="pagination-direction">
            <span class="pagination-arrow">←</span>
            上一篇
          </span>
          <span class="pagination-title">{prevPost.data.title}</span>
        </a>
      ) : (
        <div class="pagination-placeholder"></div>
      )}
      
      {nextPost ? (
        <a href={`/blog/${nextPost.id}`} class="pagination-link next">
          <span class="pagination-direction">
            下一篇
            <span class="pagination-arrow">→</span>
          </span>
          <span class="pagination-title">{nextPost.data.title}</span>
        </a>
      ) : (
        <div class="pagination-placeholder"></div>
      )}
    </div>
  </nav>
)}

<style>
  .series-pagination {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--notion-border);
  }

  .pagination-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .pagination-container {
      grid-template-columns: 1fr;
    }
  }

  .pagination-link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.25rem;
    background-color: var(--notion-bg-secondary);
    border: 1px solid var(--notion-border);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .pagination-link:hover {
    background-color: var(--notion-bg-hover);
    border-color: var(--notion-text-secondary);
  }

  .pagination-link.next {
    text-align: right;
  }

  .pagination-direction {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--notion-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  .pagination-link.next .pagination-direction {
    justify-content: flex-end;
  }

  .pagination-arrow {
    font-size: 0.875rem;
  }

  .pagination-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--notion-text);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pagination-placeholder {
    display: none;
  }

  @media (min-width: 641px) {
    .pagination-placeholder {
      display: block;
    }
  }
</style>
