---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <span class="footer-mark">孟</span>
        <span class="footer-word">孟国庆的博客</span>
      </a>
      <p>记录技术 · 分享生活 · 探索 AI</p>
      <p class="footer-links">
        <a href="/blog">文章</a>
        <a href="/series">系列</a>
        <a href="/categories">分类</a>
        <a href="/tags">标签</a>
        <a href="/about">关于</a>
      </p>
    </div>

    <p class="footer-note">
      © {currentYear} · Built with
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
    </p>
  </div>
</footer>

<style>
  /* Tinted band rather than plain background, so the page has a visible foot. */
  .site-footer {
    margin-top: auto;
    border-top: 1px solid hsl(var(--line) / 0.7);
    background-color: hsl(var(--bg-subtle) / 0.4);
  }

  .footer-inner {
    max-width: var(--page);
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: hsl(var(--fg-muted));
  }

  @media (min-width: 768px) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .footer-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 5px;
    background-color: hsl(var(--brand));
    color: #fff;
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .footer-word {
    font-size: 1rem;
    font-weight: 600;
    color: hsl(var(--fg));
  }

  .footer-brand p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0.25rem;
  }

  .footer-inner a {
    color: hsl(var(--fg-muted));
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-inner a:hover {
    color: hsl(var(--brand));
  }

  .footer-note {
    margin: 0;
    font-family: var(--font-mono);
  }
</style>