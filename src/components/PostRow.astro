---
import type { CollectionEntry } from 'astro:content';
import { postHue } from '../utils/series-hue';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Show the series name in the meta strip instead of the category. */
  showSeries?: boolean;
}

const { post, showSeries = false } = Astro.props;
const { title, description, pubDate, category, tags, series } = post.data;

// The mark only appears when it identifies something. A series is a real
// grouping; a category is not — 66 of 71 posts are 技术, so a plate reading
// 技术 on two thirds of the list is noise that looks like a label.
const mark = series ? series.trim().slice(0, 2) : '';

const href = `/blog/${post.id}`;

const formatDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(pubDate);

// ~500 CJK characters per minute is a reasonable reading pace; Latin runs
// faster, so count CJK as one unit and Latin words as ~0.5.
const text = post.body ?? '';
const cjk = (text.match(/[\u4e00-\u9fa5]/g) || []).length;
const latinWords = (text.replace(/[\u4e00-\u9fa5]/g, ' ').match(/[A-Za-z0-9]+/g) || []).length;
const minutes = Math.max(1, Math.round(cjk / 500 + latinWords / 200));
const chars = cjk + latinWords;

// Each series gets its own band hue, but confined to a narrow window around
// the brand hue so the list still reads as one colour family instead of a
// rainbow. See utils/series-hue.ts.
const hue = postHue(series);
---

<article
  class:list={['pick', mark && 'pick--marked']}
  style={`--pick-h: ${hue};`}
>
  <header class="pick-band">
    <h2 class="pick-title">
      <a href={href}>{title}</a>
    </h2>
    {mark && <span class="pick-mark" aria-hidden="true">{mark}</span>}
  </header>

  <div class="pick-meta">
    <span class="pick-meta-label">发布</span>
    <time datetime={pubDate.toISOString()}>{formatDate}</time>
    <span aria-hidden="true">·</span>
    <span>{showSeries && series ? series : category}</span>
    <span aria-hidden="true">·</span>
    <span>{minutes} 分钟</span>
    <span aria-hidden="true">·</span>
    <span>{chars} 字</span>
    <a href={href} class="pick-read">阅读全文 →</a>
  </div>

  {description && <p class="pick-desc">{description}</p>}
</article>

<style>
  /* ------------------------------------------------------------------
     One row in a post list. Dashed rules between rows keep long lists
     scannable without drawing boxes around every item.
  ------------------------------------------------------------------ */

  .pick {
    padding: 1.25rem 0;
    border-bottom: 1px dashed hsl(var(--line));
  }

  .pick:first-child {
    padding-top: 0.25rem;
  }

  /* The band is the signature element: a short tinted strip carrying the
     title in white, with the thumbnail breaking out of its bottom edge. */
  /* Reserve room for the mark only on rows that have one. */
  .pick-band {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background-color: hsl(var(--pick-h) 70% 21%);
    border-radius: var(--radius);
    transition: filter 0.15s;
  }

  .pick--marked .pick-band {
    padding-right: 4rem;
  }

  .pick:hover .pick-band {
    filter: brightness(1.08);
  }

  .pick-title {
    margin: 0;
    min-width: 0;
    /* Explicitly sans. Without this the base-layer `h2` rule in global.css
       applies the serif face, which the reference reserves for page titles
       and article section headings. */
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    color: #fff;
  }

  @media (min-width: 768px) {
    .pick-title {
      font-size: 1.125rem;
    }
  }

  .pick-title a {
    color: inherit;
    text-decoration: none;
  }

  .pick-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The mark straddles the band's lower edge, which is what makes a row read as
     one object. Because it overlaps, the strip below insets its right edge to
     clear it; rows without a mark stay flush. */
  .pick-mark {
    position: absolute;
    bottom: -0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    background: hsl(var(--pick-h) 62% 93%);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.18);
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-weight: 700;
    color: hsl(var(--pick-h) 70% 21%);
  }

  :global(.dark) .pick-mark {
    background: hsl(var(--pick-h) 28% 24%);
    color: hsl(var(--pick-h) 55% 74%);
  }

  /* Numerals share the mono stack so dates and counts line up in a column.
     The strip is muted fill, not a border. */
  .pick-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.25rem;
    padding: 0.375rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: hsl(var(--fg-muted));
    background-color: hsl(var(--bg-subtle) / 0.6);
    border-radius: var(--radius);
  }

  /* Inset past the mark that overlaps this row's top edge. */
  .pick--marked .pick-meta {
    padding-right: 4rem;
  }

  /* Read affordance rides the strip rather than taking a line of its own --
     four horizontal bands per row was one too many. */
  .pick-read {
    margin-left: auto;
    padding-left: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: hsl(var(--brand));
    text-decoration: none;
    white-space: nowrap;
  }

  .pick-read:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pick-meta-label {
    font-family: var(--font-sans);
    font-weight: 500;
    color: hsl(var(--fg-faint));
  }

  .pick-desc {
    margin: 0.625rem 0 0;
    padding: 0 0.75rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: hsl(var(--fg-muted));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>