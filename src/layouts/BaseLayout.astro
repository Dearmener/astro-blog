---
import BaseHead from './BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  tags?: string[];
  ogSlug?: string;
}

const { title, description, image, type, publishedTime, modifiedTime, author, tags, ogSlug } = Astro.props;
---

<BaseHead
  title={title}
  description={description}
  image={image}
  type={type}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={author}
  tags={tags}
  ogSlug={ogSlug}
>
  <Header />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
  <SearchModal />
</BaseHead>
