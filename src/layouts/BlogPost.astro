---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SeriesStrip from '../components/SeriesStrip.astro';
import SeriesPagination from '../components/SeriesPagination.astro';
import ShareButtons from '../components/ShareButtons.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { tagChipStyle } from '../utils/tag-hue';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: Heading[];
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, series } = post.data;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const formattedUpdatedDate = updatedDate
  ? new Intl.DateTimeFormat('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updatedDate)
  : null;

const showToc = headings.filter((h) => h.depth >= 2 && h.depth <= 3).length > 0;
---

<BaseLayout
  title={`${title} | 孟国庆的博客`}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
  ogSlug={post.id}
>
  <div class="blog-post-layout">
    <article class="notion-page">
      <div class="notion-content">
        <div class="article-grid">
        {/* Empty left track. The grid is [margin | prose | margin+rail] so the
            prose can sit on the page's centre line; without a node in the
            first track the prose and rail would slide into it. */}
        <div class="article-margin" aria-hidden="true"></div>
        <div class="notion-column">
          {series && <SeriesStrip series={series} currentSlug={post.id} posts={allPosts} />}
        <header class="notion-header">
          <h1 class="notion-title">{title}</h1>
          
          {/* One flat metadata line instead of a labelled property table.
              The icons were decorative and had to be desaturated and dimmed
              to stay quiet, which is a sign they did not belong. */}
          <div class="notion-meta">
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            {formattedUpdatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <time datetime={updatedDate?.toISOString()}>{formattedUpdatedDate} 更新</time>
              </>
            )}
            {category && (
              <>
                <span aria-hidden="true">·</span>
                <a href={`/categories/${category}`} class="notion-link">{category}</a>
              </>
            )}
          </div>

          {tags && tags.length > 0 && (
            <div class="notion-tags">
              {tags.map((tag: string) => (
                <a href={`/tags/${tag}`} class="notion-tag" style={tagChipStyle(tag)}>
                  {tag}
                </a>
              ))}
            </div>
          )}

          {description && (
            <p class="notion-description">{description}</p>
          )}
        </header>
        
        <div class="notion-body">
          <slot />
        </div>

        <ShareButtons title={title} description={description} url={Astro.url.href} />

        {series && (
          <SeriesPagination series={series} currentSlug={post.id} posts={allPosts} />
        )}

        {/* The rail is for in-page navigation only. Sibling navigation lives in the
             series strip above the title and prev/next at the foot; putting a
             second, different-kind of list here made the two easy to confuse. */}
        </div>
        <aside class="article-rail">
          {showToc && <TableOfContents headings={headings} />}
        </aside>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .blog-post-layout {
    position: relative;
  }

  /* Content column plus a 17rem rail holding the in-page table of contents.
     The prose keeps its own 47rem measure inside the column. */
  /* Content column plus a 17rem rail holding the in-page table of contents.

     Three breakpoints, because "prose centred with a rail in the margin" and
     "rail does not squeeze the prose" cannot both hold on a narrow screen:

       >= 1408px  [margin | prose | margin+rail]  prose exactly centred
       >= 1024px  [prose | rail] centred as a pair, gap 32px
       <  1024px  prose alone, rail dropped

     A two-column `minmax(0,1fr) 17rem` grid could do neither: the prose
     capped at 47rem left ~100px of dead space inside an oversized first
     column, so the rail floated far from the text. */
  .article-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: minmax(0, var(--measure)) 17rem;
      justify-content: center;
    }
  }

  @media (min-width: 1408px) {
    .article-grid {
      grid-template-columns:
        minmax(17rem, 1fr)
        minmax(0, var(--measure))
        minmax(17rem, 1fr);
      justify-content: stretch;
    }
  }

  /* The empty left track only exists in the widest layout. */
  .article-margin {
    display: none;
  }

  @media (min-width: 1408px) {
    .article-margin {
      display: block;
    }
  }

  /* `min-width: auto` on a grid item floors it at its own min-content width,
     so one wide descendant (a code block, a table) pushed the whole track past
     the viewport on narrow screens. */
  .notion-column {
    min-width: 0;
  }

  .article-rail {
    min-width: 0;
    /* Grid items stretch to the row height by default, which left the rail
       reporting a viewport-tall box even when its content was a few lines --
       and a sticky box that tall cannot fit above the footer at the end of
       the page. Size it to its own content instead. */
    align-self: start;
  }

  @media (min-width: 1024px) {
    .article-rail {
      /* Offset by the measured header height (published by Header.astro) so
         the rail parks directly beneath it instead of sliding underneath. */
      position: sticky;
      top: calc(var(--header-h, 104px) + 1rem);
      max-height: calc(100vh - var(--header-h, 104px) - 2rem);
      overflow-y: auto;
      /* Keep the rail's scrollbar from reading as a second column edge. */
      scrollbar-width: thin;
      scrollbar-color: hsl(var(--line)) transparent;
    }
  }

  .article-rail::-webkit-scrollbar {
    width: 4px;
  }

  .article-rail::-webkit-scrollbar-track {
    background: transparent;
  }

  .article-rail::-webkit-scrollbar-thumb {
    background-color: hsl(var(--line));
    border-radius: 2px;
  }
</style>
