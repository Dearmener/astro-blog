---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SeriesNav from '../components/SeriesNav.astro';
import SeriesPagination from '../components/SeriesPagination.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: Heading[];
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, category, tags, series } = post.data;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const formattedUpdatedDate = updatedDate
  ? new Intl.DateTimeFormat('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updatedDate)
  : null;

const showToc = headings.filter((h) => h.depth >= 2 && h.depth <= 3).length > 0;
---

<BaseLayout title={`${title} | My Blog`} description={description} image={heroImage}>
  <div class="blog-post-layout">
    {series && (
      <SeriesNav series={series} currentSlug={post.id} posts={allPosts} />
    )}
    
    <article class="notion-page">
      {heroImage && (
        <div class="notion-cover">
          <img src={heroImage} alt={title} />
        </div>
      )}
      
      <div class="notion-content">
        <header class="notion-header">
          {series && (
            <a href={`/series/${encodeURIComponent(series)}`} class="series-badge">
              <span class="series-badge-icon">📚</span>
              <span class="series-badge-text">{series}</span>
            </a>
          )}
          
          <h1 class="notion-title">{title}</h1>
          
          <div class="notion-properties">
            <div class="notion-property">
              <span class="notion-property-icon">📅</span>
              <span class="notion-property-label">创建时间</span>
              <time datetime={pubDate.toISOString()} class="notion-property-value">
                {formattedDate}
              </time>
            </div>
            
            {formattedUpdatedDate && (
              <div class="notion-property">
                <span class="notion-property-icon">✏️</span>
                <span class="notion-property-label">更新时间</span>
                <span class="notion-property-value">{formattedUpdatedDate}</span>
              </div>
            )}
            
            {category && (
              <div class="notion-property">
                <span class="notion-property-icon">📁</span>
                <span class="notion-property-label">分类</span>
                <a href={`/categories/${category}`} class="notion-property-value notion-link">
                  {category}
                </a>
              </div>
            )}
            
            {tags && tags.length > 0 && (
              <div class="notion-property">
                <span class="notion-property-icon">🏷️</span>
                <span class="notion-property-label">标签</span>
                <div class="notion-tags">
                  {tags.map((tag: string, index: number) => (
                    <a href={`/tags/${tag}`} class={`notion-tag notion-tag-${index % 6}`}>
                      {tag}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
          
          {description && (
            <p class="notion-description">{description}</p>
          )}
        </header>
        
        <div class="notion-body">
          <slot />
        </div>
        
        {series && (
          <SeriesPagination series={series} currentSlug={post.id} posts={allPosts} />
        )}
        
        {showToc && <TableOfContents headings={headings} />}
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .blog-post-layout {
    position: relative;
  }

  .series-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    background-color: var(--notion-bg-secondary);
    border: 1px solid var(--notion-border);
    border-radius: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--notion-text-secondary);
    text-decoration: none;
    margin-bottom: 0.75rem;
    transition: all 0.15s ease;
  }

  .series-badge:hover {
    background-color: var(--notion-bg-hover);
    color: var(--notion-text);
    border-color: var(--notion-text-secondary);
  }

  .series-badge-icon {
    font-size: 0.875rem;
  }

  .series-badge-text {
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
