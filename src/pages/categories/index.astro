---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const categories = [...new Set(posts.map((post) => post.data.category))];

const categoryStats = categories.map((category) => ({
  name: category,
  count: posts.filter((post) => post.data.category === category).length,
})).sort((a, b) => b.count - a.count);
---

<BaseLayout title="文章分类 | 孟国庆的博客" description="按分类浏览所有博客文章">
  <div class="notion-page-content">
    <header class="notion-page-header">
      <div class="notion-page-icon">📁</div>
      <h1 class="notion-page-title">分类</h1>
      <p class="notion-page-desc">共 {categories.length} 个分类</p>
    </header>

    <div class="notion-database">
      <div class="notion-db-header">
        <div class="notion-db-col notion-db-col-name">名称</div>
        <div class="notion-db-col notion-db-col-count">文章数</div>
      </div>
      {categoryStats.map((cat) => (
        <a href={`/categories/${cat.name}`} class="notion-db-row">
          <div class="notion-db-col notion-db-col-name">
            <span class="notion-db-icon">📂</span>
            <span>{cat.name}</span>
          </div>
          <div class="notion-db-col notion-db-col-count">
            <span class="notion-db-badge">{cat.count}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .notion-page-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  @media (min-width: 768px) {
    .notion-page-content {
      padding: 2rem 4rem;
    }
  }

  .notion-page-header {
    margin-bottom: 2rem;
  }

  .notion-page-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .notion-page-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--notion-text);
    margin-bottom: 0.25rem;
  }

  .notion-page-desc {
    font-size: 0.9375rem;
    color: var(--notion-text-secondary);
  }

  .notion-database {
    border: 1px solid var(--notion-border);
    border-radius: 0.375rem;
    overflow: hidden;
  }

  .notion-db-header {
    display: flex;
    background-color: var(--notion-bg-secondary);
    border-bottom: 1px solid var(--notion-border);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--notion-text-secondary);
    text-transform: uppercase;
  }

  .notion-db-row {
    display: flex;
    border-bottom: 1px solid var(--notion-border);
    transition: background-color 0.1s;
  }

  .notion-db-row:last-child {
    border-bottom: none;
  }

  .notion-db-row:hover {
    background-color: var(--notion-bg-secondary);
  }

  .notion-db-col {
    padding: 0.75rem 1rem;
  }

  .notion-db-col-name {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--notion-text);
  }

  .notion-db-col-count {
    width: 100px;
    text-align: right;
  }

  .notion-db-icon {
    font-size: 1rem;
  }

  .notion-db-badge {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    background-color: var(--notion-bg-secondary);
    border-radius: 999px;
    color: var(--notion-text-secondary);
  }
</style>
