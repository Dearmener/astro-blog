---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const categories = [...new Set(posts.map((post) => post.data.category))];

const categoryStats = categories.map((category) => ({
  name: category,
  count: posts.filter((post) => post.data.category === category).length,
})).sort((a, b) => b.count - a.count);
---

<BaseLayout title="文章分类 | 孟国庆的博客" description="按分类浏览所有博客文章">
  <div class="list-page">
    <nav class="list-crumbs">
      <a href="/">首页</a>
      <span>/</span>
      <span>分类</span>
    </nav>

    <header class="list-head">
      <div class="list-head-main">
        <span class="list-chip"></span>
        <h1 class="list-title">分类</h1>
        <span class="list-count">{categories.length} 个分类 · {posts.length} 篇文章</span>
      </div>
      <a href="/blog" class="list-head-link">全部文章 →</a>
    </header>

    <div class="db">
      <div class="db-head">
        <span>名称</span>
        <span>文章数</span>
      </div>
      {categoryStats.map((cat) => (
        <a href={`/categories/${cat.name}`} class="db-row">
          <span class="db-name">{cat.name}</span>
          <span class="db-count">{cat.count}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .db {
    margin-top: 1.75rem;
  }

  .db-head,
  .db-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.625rem 0.75rem;
  }

  .db-head {
    font-size: 0.6875rem;
    font-weight: 600;
    color: hsl(var(--fg-faint));
    border-bottom: 1px solid hsl(var(--line));
  }

  .db-row {
    text-decoration: none;
    border-bottom: 1px dashed hsl(var(--line));
    transition: background-color 0.15s;
  }

  .db-row:hover {
    background-color: hsl(var(--bg-subtle) / 0.6);
  }

  .db-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: hsl(var(--fg));
  }

  .db-count {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    color: hsl(var(--fg-muted));
  }
</style>