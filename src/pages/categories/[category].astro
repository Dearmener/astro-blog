---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getCollection } from 'astro:content';
import { postHue } from '../../utils/series-hue';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = [...new Set(posts.map((post) => post.data.category))];
  
  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      posts: posts.filter((post) => post.data.category === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

interface Props {
  category: string;
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`${category} | 孟国庆的博客`} description={`查看所有 ${category} 分类的文章`}>
  <div class="list-page">
    <nav class="list-crumbs">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/categories">分类</a>
      <span>/</span>
      <span>{category}</span>
    </nav>

    <header class="list-head">
      <div class="list-head-main">
        <span class="list-chip" style={`--chip-h: ${postHue()} 70% 21%;`}></span>
        <h1 class="list-title">{category}</h1>
        <span class="list-count">共 {posts.length} 篇 · 最新在前</span>
      </div>
      <a href="/blog" class="list-head-link">全部文章 →</a>
    </header>

    <div class="picks">
      {posts.map((post) => <PostRow post={post} showSeries />)}
    </div>
  </div>
</BaseLayout>
