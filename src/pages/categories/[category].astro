---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = [...new Set(posts.map((post) => post.data.category))];
  
  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      posts: posts.filter((post) => post.data.category === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

interface Props {
  category: string;
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`${category} | My Blog`} description={`查看所有 ${category} 分类的文章`}>
  <div class="notion-page-content">
    <header class="notion-page-header">
      <nav class="notion-breadcrumb">
        <a href="/">首页</a>
        <span class="notion-breadcrumb-sep">/</span>
        <a href="/categories">分类</a>
        <span class="notion-breadcrumb-sep">/</span>
        <span>{category}</span>
      </nav>
      
      <div class="notion-page-icon">📂</div>
      <h1 class="notion-page-title">{category}</h1>
      <p class="notion-page-desc">共 {posts.length} 篇文章</p>
    </header>

    <div class="notion-gallery">
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          heroImage={post.data.heroImage}
          category={post.data.category}
          tags={post.data.tags}
          slug={post.slug}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .notion-page-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  @media (min-width: 768px) {
    .notion-page-content {
      padding: 2rem 4rem;
    }
  }

  .notion-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--notion-text-secondary);
    margin-bottom: 1rem;
  }

  .notion-breadcrumb a {
    color: var(--notion-text-secondary);
    transition: color 0.1s;
  }

  .notion-breadcrumb a:hover {
    color: var(--notion-text);
  }

  .notion-breadcrumb-sep {
    opacity: 0.5;
  }

  .notion-page-header {
    margin-bottom: 2rem;
  }

  .notion-page-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .notion-page-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--notion-text);
    margin-bottom: 0.25rem;
  }

  .notion-page-desc {
    font-size: 0.9375rem;
    color: var(--notion-text-secondary);
  }

  .notion-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
</style>
