---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const allTags = posts.flatMap((post) => post.data.tags);

const tagStats = [...new Set(allTags)].map((tag) => ({
  name: tag,
  count: allTags.filter((t) => t === tag).length,
})).sort((a, b) => b.count - a.count);
---

<BaseLayout title="标签云 | 孟国庆的博客" description="按标签浏览所有博客文章">
  <div class="notion-page-content">
    <header class="notion-page-header">
      <div class="notion-page-icon">🏷️</div>
      <h1 class="notion-page-title">标签</h1>
      <p class="notion-page-desc">共 {tagStats.length} 个标签</p>
    </header>

    <div class="notion-tag-cloud">
      {tagStats.map((tag, index) => (
        <a href={`/tags/${tag.name}`} class={`notion-tag-item notion-tag-${index % 6}`}>
          <span class="notion-tag-name">{tag.name}</span>
          <span class="notion-tag-count">{tag.count}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .notion-page-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  @media (min-width: 768px) {
    .notion-page-content {
      padding: 2rem 4rem;
    }
  }

  .notion-page-header {
    margin-bottom: 2rem;
  }

  .notion-page-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .notion-page-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--notion-text);
    margin-bottom: 0.25rem;
  }

  .notion-page-desc {
    font-size: 0.9375rem;
    color: var(--notion-text-secondary);
  }

  .notion-tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .notion-tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    transition: opacity 0.1s;
  }

  .notion-tag-item:hover {
    opacity: 0.8;
  }

  .notion-tag-count {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .notion-tag-0 { background-color: #d3e5ef; color: #1a5276; }
  .notion-tag-1 { background-color: #e8deee; color: #6b3fa0; }
  .notion-tag-2 { background-color: #f5e0e9; color: #9c3f66; }
  .notion-tag-3 { background-color: #ffe2dd; color: #9c3a2e; }
  .notion-tag-4 { background-color: #fadec9; color: #8c5a32; }
  .notion-tag-5 { background-color: #dbeddb; color: #3d6b3d; }

  :global(.dark) .notion-tag-0 { background-color: rgba(82, 156, 202, 0.3); color: #7ebbd6; }
  :global(.dark) .notion-tag-1 { background-color: rgba(154, 109, 215, 0.3); color: #b794d6; }
  :global(.dark) .notion-tag-2 { background-color: rgba(226, 85, 161, 0.3); color: #e896c0; }
  :global(.dark) .notion-tag-3 { background-color: rgba(255, 115, 105, 0.3); color: #ff9c94; }
  :global(.dark) .notion-tag-4 { background-color: rgba(255, 163, 68, 0.3); color: #ffb86b; }
  :global(.dark) .notion-tag-5 { background-color: rgba(77, 171, 154, 0.3); color: #8bc8bc; }
</style>
