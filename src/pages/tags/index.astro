---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { tagChipStyle } from '../../utils/tag-hue';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const allTags = posts.flatMap((post) => post.data.tags);

const tagStats = [...new Set(allTags)].map((tag) => ({
  name: tag,
  count: allTags.filter((t) => t === tag).length,
})).sort((a, b) => b.count - a.count);
---

<BaseLayout title="标签云 | 孟国庆的博客" description="按标签浏览所有博客文章">
  <div class="list-page">
    <nav class="list-crumbs">
      <a href="/">首页</a>
      <span>/</span>
      <span>标签</span>
    </nav>

    <header class="list-head">
      <div class="list-head-main">
        <h1 class="list-title">标签</h1>
        <span class="list-count">{tagStats.length} 个标签 · {posts.length} 篇文章</span>
      </div>
      <a href="/blog" class="list-head-link">全部文章 →</a>
    </header>

    <div class="notion-tag-cloud">
      {tagStats.map((tag) => (
        <a href={`/tags/${tag.name}`} class="notion-tag-item" style={tagChipStyle(tag.name)}>
          <span class="notion-tag-name">{tag.name}</span>
          <span class="notion-tag-count">{tag.count}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>


<style>
  .notion-tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .notion-tag-name {
    min-width: 0;
  }

  .notion-tag-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.3125rem 0.625rem;
    font-size: 0.8125rem;
    color: hsl(var(--tag-h) 62% 30%);
    background-color: hsl(var(--tag-h) 62% 94%);
    border-radius: 3px;
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }

  .notion-tag-item:hover {
    color: hsl(var(--tag-h) 62% 97%);
    background-color: hsl(var(--tag-h) 58% 34%);
  }

  :global(.dark) .notion-tag-item {
    color: hsl(var(--tag-h) 55% 78%);
    background-color: hsl(var(--tag-h) 40% 20%);
  }

  :global(.dark) .notion-tag-item:hover {
    color: hsl(var(--tag-h) 60% 92%);
    background-color: hsl(var(--tag-h) 45% 30%);
  }

  .notion-tag-count {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.6875rem;
    color: hsl(var(--fg-faint));
  }
</style>
