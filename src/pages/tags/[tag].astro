---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getCollection } from 'astro:content';
import { tagHue } from '../../utils/tag-hue';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

interface Props {
  tag: string;
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
}

const { tag, posts } = Astro.props;

---

<BaseLayout title={`#${tag} | 孟国庆的博客`} description={`查看所有标签为 ${tag} 的文章`}>
  <div class="list-page">
    <nav class="list-crumbs">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/tags">标签</a>
      <span>/</span>
      <span>{tag}</span>
    </nav>

    <header class="list-head">
      <div class="list-head-main">
        <span class="list-chip" style={`--chip-h: ${tagHue(tag)} 62% 30%;`}></span>
        <h1 class="list-title">#{tag}</h1>
        <span class="list-count">共 {posts.length} 篇 · 最新在前</span>
      </div>
      <a href="/tags" class="list-head-link">全部标签 →</a>
    </header>

    <div class="picks">
      {posts.map((post) => <PostRow post={post} showSeries />)}
    </div>
  </div>
</BaseLayout>
