---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(posts.map((post) => post.data.category))];
---

<BaseLayout title="全部文章 | My Blog" description="浏览所有博客文章">
  <div class="notion-page-content">
    <header class="notion-page-header">
      <div class="notion-page-icon">📝</div>
      <h1 class="notion-page-title">全部文章</h1>
      <p class="notion-page-desc">共 {posts.length} 篇文章</p>
    </header>

    <div class="notion-filter">
      <a href="/blog" class="notion-filter-item active">全部</a>
      {categories.map((category) => (
        <a href={`/categories/${category}`} class="notion-filter-item">
          {category}
        </a>
      ))}
    </div>

    <div class="notion-gallery">
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          heroImage={post.data.heroImage}
          category={post.data.category}
          tags={post.data.tags}
          slug={post.slug}
        />
      ))}
    </div>

    {posts.length === 0 && (
      <div class="notion-empty">
        <span class="notion-empty-icon">📭</span>
        <p>暂无文章</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .notion-page-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  @media (min-width: 768px) {
    .notion-page-content {
      padding: 2rem 4rem;
    }
  }

  .notion-page-header {
    margin-bottom: 2rem;
  }

  .notion-page-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .notion-page-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--notion-text);
    margin-bottom: 0.25rem;
  }

  .notion-page-desc {
    font-size: 0.9375rem;
    color: var(--notion-text-secondary);
  }

  .notion-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--notion-border);
  }

  .notion-filter-item {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    color: var(--notion-text-secondary);
    border-radius: 0.375rem;
    transition: background-color 0.1s, color 0.1s;
  }

  .notion-filter-item:hover {
    background-color: var(--notion-bg-hover);
    color: var(--notion-text);
  }

  .notion-filter-item.active {
    background-color: var(--notion-bg-secondary);
    color: var(--notion-text);
  }

  .notion-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .notion-empty {
    text-align: center;
    padding: 4rem 0;
    color: var(--notion-text-secondary);
  }

  .notion-empty-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 1rem;
  }
</style>
