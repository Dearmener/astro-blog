---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getCollection } from 'astro:content';

// Filter out series posts - only show standalone articles
const posts = (await getCollection('blog', ({ data }) => !data.draft && !data.series))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(posts.map((post) => post.data.category))];
---

<BaseLayout title="独立文章 | 孟国庆的博客" description="浏览所有独立博客文章">
  <div class="list-page">
    <header class="list-head">
      <div class="list-head-main">
        <span class="list-chip" style="--chip-h: 124 70% 21%;"></span>
        <h1 class="list-title">独立文章</h1>
        <span class="list-count">共 {posts.length} 篇 · 最新在前</span>
      </div>
      <a href="/series" class="list-head-link">系列教程 →</a>
    </header>

    {categories.length > 1 && (
      <div class="list-filter">
        <a href="/blog" class="list-filter-item active">全部</a>
        {categories.map((category) => (
          <a href={`/categories/${category}`} class="list-filter-item">
            {category}
          </a>
        ))}
      </div>
    )}

    <div class="picks">
      {posts.map((post) => <PostRow post={post} />)}
    </div>

    {posts.length === 0 && (
      <div class="notion-empty">
        <span class="notion-empty-icon">📭</span>
        <p>暂无文章</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .picks {
    margin-top: 1.5rem;
  }

  .notion-empty {
    text-align: center;
    padding: 4rem 0;
    color: hsl(var(--fg-muted));
  }

  .notion-empty-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 1rem;
  }
</style>
