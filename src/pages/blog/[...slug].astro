---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  const htmlPosts = await getCollection('htmlPosts');

  const paths = [
    ...blogPosts.map((post) => ({
      params: { slug: post.id },
      props: { post, source: 'blog' as const },
    })),
    ...htmlPosts.map((post) => ({
      params: { slug: post.id },
      props: { post, source: 'html' as const },
    })),
  ];

  return paths;
}

const { post, source } = Astro.props;

let Content: any;
let headings: any[] = [];
let htmlContent: string | undefined;

if (source === 'blog') {
  const rendered = await render(post);
  Content = rendered.Content;
  headings = rendered.headings;
} else {
  htmlContent = post.data.htmlContent;
}
---

<BlogPost post={post} headings={headings} htmlContent={htmlContent}>
  {source === 'blog' && <Content />}
</BlogPost>
