---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于 | 孟国庆的博客" description="了解更多关于我的信息">
  <div class="notion-page-content">
    <header class="notion-page-header">
      <div class="notion-page-icon">👋</div>
      <h1 class="notion-page-title">关于我</h1>
    </header>

    <div class="notion-body">
      <div class="notion-callout">
        <span class="notion-callout-icon">💡</span>
        <div class="notion-callout-content">
          你好！欢迎来到我的个人博客。
        </div>
      </div>

      <p>
        我是一名热爱技术的开发者，专注于 Web 开发和用户体验设计。这个博客是我分享技术心得、记录学习历程和探索新事物的地方。
      </p>

      <h2>我做什么</h2>
      
      <div class="notion-toggle">
        <div class="notion-toggle-header">
          <span>💻</span>
          <span>前端开发</span>
        </div>
        <div class="notion-toggle-content">
          React, Vue, TypeScript, Astro
        </div>
      </div>
      
      <div class="notion-toggle">
        <div class="notion-toggle-header">
          <span>⚙️</span>
          <span>后端开发</span>
        </div>
        <div class="notion-toggle-content">
          Node.js, Python, Go
        </div>
      </div>
      
      <div class="notion-toggle">
        <div class="notion-toggle-header">
          <span>🚀</span>
          <span>DevOps</span>
        </div>
        <div class="notion-toggle-content">
          Docker, CI/CD, Kubernetes
        </div>
      </div>

      <h2>联系方式</h2>

      <div class="notion-link-list">
        <a href="https://github.com" target="_blank" rel="noopener" class="notion-link-item">
          <span class="notion-link-icon">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </span>
          <span class="notion-link-text">GitHub</span>
          <span class="notion-link-url">github.com/username</span>
        </a>
        
        <a href="https://twitter.com" target="_blank" rel="noopener" class="notion-link-item">
          <span class="notion-link-icon">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </span>
          <span class="notion-link-text">Twitter</span>
          <span class="notion-link-url">twitter.com/username</span>
        </a>
        
        <a href="mailto:hello@example.com" class="notion-link-item">
          <span class="notion-link-icon">📧</span>
          <span class="notion-link-text">Email</span>
          <span class="notion-link-url">hello@example.com</span>
        </a>
      </div>

      <h2>关于这个博客</h2>

      <p>
        这个博客使用 <a href="https://astro.build">Astro</a> 构建，采用 Notion 风格设计。支持暗黑模式、文章分类、标签系统和全文搜索。
      </p>

      <div class="notion-callout notion-callout-gray">
        <span class="notion-callout-icon">🙏</span>
        <div class="notion-callout-content">
          感谢你的访问！
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notion-page-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  @media (min-width: 768px) {
    .notion-page-content {
      padding: 2rem 4rem;
    }
  }

  .notion-page-header {
    margin-bottom: 2rem;
  }

  .notion-page-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .notion-page-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--notion-text);
  }

  .notion-callout {
    display: flex;
    gap: 0.75rem;
    padding: 1rem;
    background-color: rgba(255, 212, 0, 0.1);
    border-radius: 0.375rem;
    margin-bottom: 1rem;
  }

  .notion-callout-gray {
    background-color: var(--notion-bg-secondary);
  }

  .notion-callout-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .notion-callout-content {
    color: var(--notion-text);
    line-height: 1.5;
  }

  .notion-toggle {
    border: 1px solid var(--notion-border);
    border-radius: 0.375rem;
    margin-bottom: 0.5rem;
  }

  .notion-toggle-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-weight: 500;
    color: var(--notion-text);
    cursor: pointer;
  }

  .notion-toggle-content {
    padding: 0 1rem 0.75rem 2.5rem;
    color: var(--notion-text-secondary);
    font-size: 0.9375rem;
  }

  .notion-link-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 1rem 0;
  }

  .notion-link-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.375rem;
    transition: background-color 0.1s;
    color: var(--notion-text);
  }

  .notion-link-item:hover {
    background-color: var(--notion-bg-hover);
  }

  .notion-link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--notion-text-secondary);
  }

  .notion-link-text {
    font-weight: 500;
  }

  .notion-link-url {
    margin-left: auto;
    font-size: 0.875rem;
    color: var(--notion-text-secondary);
  }
</style>
