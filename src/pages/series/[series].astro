---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { seriesHue } from '../../utils/series-hue';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  const seriesMap = new Map<string, typeof posts>();
  posts.forEach((post) => {
    if (!post.data.series) return;
    const list = seriesMap.get(post.data.series) ?? [];
    list.push(post);
    seriesMap.set(post.data.series, list);
  });

  return Array.from(seriesMap.entries()).map(([series, list]) => ({
    params: { series },
    props: {
      series,
      posts: [...list].sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0)),
    },
  }));
}

interface Props {
  series: string;
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
}

const { series, posts } = Astro.props;
const hue = seriesHue(series);

const formatDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout title={`${series} | 系列教程`} description={`${series} 系列教程，共 ${posts.length} 篇文章`}>
  <div class="list-page">
    <nav class="list-crumbs">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/series">系列</a>
      <span>/</span>
      <span>{series}</span>
    </nav>

    <header class="list-head">
      <div class="list-head-main">
        <h1 class="list-title">{series}</h1>
        <span class="list-count">共 {posts.length} 篇 · 按顺序阅读</span>
      </div>
      <a href="/series" class="list-head-link">全部系列 →</a>
    </header>

    <ol class="steps" style={`--series-h: ${hue};`}>
      {posts.map((post, index) => (
        <li class="step">
          <div class="step-marker">
            <span class="step-num">{index + 1}</span>
          </div>
          <div class="step-body">
            <h2 class="step-title">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h2>
            {post.data.description && <p class="step-desc">{post.data.description}</p>}
            <div class="step-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate.format(post.data.pubDate)}
              </time>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style>
  /* A numbered spine conveys reading order, which a flat list cannot. The
     connector and numerals carry the series accent. */
  .steps {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    gap: 1rem;
  }

  .step-marker {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 1.75rem;
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 50%;
    border: 1px solid hsl(var(--line-strong));
    background-color: hsl(var(--bg));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: hsl(var(--fg-faint));
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }

  .step:hover .step-num {
    background-color: hsl(var(--series-h) 46% 27%);
    border-color: hsl(var(--series-h) 46% 27%);
    color: #fff;
  }

  /* Connector runs behind the numeral, stopping at the last step. */
  .step:not(:last-child) .step-marker::after {
    content: "";
    position: absolute;
    top: 1.75rem;
    bottom: -0.75rem;
    width: 1px;
    background-color: hsl(var(--line));
  }

  .step-body {
    flex: 1;
    min-width: 0;
    padding-bottom: 1.75rem;
  }

  .step:last-child .step-body {
    padding-bottom: 0;
  }

  .step-title {
    margin: 0.125rem 0 0.375rem;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .step-title a {
    color: hsl(var(--fg));
    text-decoration: none;
  }

  .step-title a:hover {
    color: hsl(var(--brand));
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .step-desc {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: hsl(var(--fg-muted));
  }

  .step-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: hsl(var(--fg-faint));
  }
</style>