---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);

// Group posts by series
const seriesMap = new Map<string, { posts: typeof posts; description: string }>();

posts.forEach((post) => {
  if (post.data.series) {
    const existing = seriesMap.get(post.data.series);
    if (existing) {
      existing.posts.push(post);
    } else {
      seriesMap.set(post.data.series, {
        posts: [post],
        description: post.data.description || '',
      });
    }
  }
});

// Sort posts within each series by order
const seriesList = Array.from(seriesMap.entries())
  .map(([name, data]) => ({
    name,
    posts: data.posts.sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0)),
    description: data.posts.sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0))[0]?.data.description || '',
    lastUpdated: data.posts.reduce((latest, post) => {
      return post.data.pubDate > latest ? post.data.pubDate : latest;
    }, data.posts[0]?.data.pubDate || new Date()),
  }))
  .sort((a, b) => b.lastUpdated.getTime() - a.lastUpdated.getTime());

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date);
};
---

<BaseLayout title="系列教程" description="按主题组织的系列教程，帮助你系统性地学习">
  <main class="series-index-page">
    <div class="series-container">
      <header class="page-header">
        <div class="page-icon">📚</div>
        <h1 class="page-title">系列教程</h1>
        <p class="page-description">
          按主题组织的系列文章，帮助你系统性地学习
        </p>
      </header>

      {seriesList.length === 0 ? (
        <div class="empty-state">
          <p>暂无系列教程</p>
        </div>
      ) : (
        <div class="series-list">
          {seriesList.map((series) => (
            <a href={`/series/${encodeURIComponent(series.name)}`} class="series-item">
              <div class="series-icon">📖</div>
              <div class="series-content">
                <div class="series-header">
                  <h2 class="series-name">{series.name}</h2>
                  <span class="series-meta">{series.posts.length} 篇 · 更新于 {formatDate(series.lastUpdated)}</span>
                </div>
                {series.description && (
                  <p class="series-description">{series.description}</p>
                )}
                <div class="series-preview">
                  {series.posts.slice(0, 3).map((post, index) => (
                    <span class="preview-item">
                      <span class="preview-number">{index + 1}.</span>
                      <span class="preview-title">{post.data.title}</span>
                    </span>
                  ))}
                  {series.posts.length > 3 && (
                    <span class="preview-more">...还有 {series.posts.length - 3} 篇</span>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .series-index-page {
    min-height: calc(100vh - 64px);
    padding: 2rem 1.5rem 4rem;
  }

  .series-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--notion-text);
    margin: 0 0 0.25rem 0;
  }

  .page-description {
    font-size: 0.9375rem;
    color: var(--notion-text-secondary);
    margin: 0;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--notion-text-secondary);
  }

  /* Series List */
  .series-list {
    display: flex;
    flex-direction: column;
  }

  .series-item {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 0;
    text-decoration: none;
    border-bottom: 1px solid var(--notion-border);
    transition: background-color 0.1s;
  }

  .series-item:first-child {
    padding-top: 0;
  }

  .series-item:last-child {
    border-bottom: none;
  }

  .series-item:hover {
    background-color: var(--notion-bg-hover);
    margin: 0 -1rem;
    padding-left: 1rem;
    padding-right: 1rem;
    border-radius: 6px;
    border-bottom-color: transparent;
  }

  .series-icon {
    font-size: 2rem;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--notion-bg-secondary);
    border-radius: 8px;
  }

  .series-content {
    flex: 1;
    min-width: 0;
  }

  .series-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.375rem;
  }

  .series-name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--notion-text);
    margin: 0;
    line-height: 1.4;
    flex: 1;
  }

  .series-meta {
    font-size: 0.75rem;
    color: var(--notion-text-secondary);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .series-description {
    font-size: 0.875rem;
    color: var(--notion-text-secondary);
    margin: 0 0 0.75rem 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .series-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .preview-item {
    font-size: 0.8125rem;
    color: var(--notion-text-secondary);
    display: flex;
    gap: 0.25rem;
  }

  .preview-number {
    color: var(--notion-text-tertiary);
  }

  .preview-title {
    max-width: 200px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .preview-more {
    font-size: 0.8125rem;
    color: var(--notion-text-tertiary);
    font-style: italic;
  }

  @media (max-width: 480px) {
    .series-icon {
      width: 40px;
      height: 40px;
      font-size: 1.5rem;
    }

    .series-header {
      flex-direction: column;
      gap: 0.25rem;
    }

    .preview-title {
      max-width: 120px;
    }
  }
</style>
