---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { seriesHue } from '../../utils/series-hue';

const posts = await getCollection('blog', ({ data }) => !data.draft);

const seriesMap = new Map<string, typeof posts>();
posts.forEach((post) => {
  if (!post.data.series) return;
  const list = seriesMap.get(post.data.series) ?? [];
  list.push(post);
  seriesMap.set(post.data.series, list);
});

const byOrder = (a: (typeof posts)[number], b: (typeof posts)[number]) =>
  (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0);

const seriesList = Array.from(seriesMap.entries())
  .map(([name, list]) => {
    const ordered = [...list].sort(byOrder);
    return {
      name,
      posts: ordered,
      count: ordered.length,
      blurb: ordered[0]?.data.description ?? '',
      lastUpdated: ordered.reduce(
        (latest, p) => (p.data.pubDate > latest ? p.data.pubDate : latest),
        ordered[0].data.pubDate,
      ),
    };
  })
  .sort((a, b) => b.lastUpdated.getTime() - a.lastUpdated.getTime());

const totalPosts = seriesList.reduce((n, s) => n + s.count, 0);

const formatDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout title="系列教程" description="按主题组织的系列教程，帮助你系统性地学习">
  <div class="list-page">
    <nav class="list-crumbs">
      <a href="/">首页</a>
      <span>/</span>
      <span>系列</span>
    </nav>

    <header class="list-head">
      <div class="list-head-main">
        <span class="list-chip"></span>
        <h1 class="list-title">系列教程</h1>
        <span class="list-count">{seriesList.length} 个系列 · 共 {totalPosts} 篇</span>
      </div>
      <a href="/blog" class="list-head-link">独立文章 →</a>
    </header>

    {seriesList.length === 0 ? (
      <div class="series-empty">暂无系列教程</div>
    ) : (
      <div class="series-list">
        {seriesList.map((series) => (
          <a
            href={`/series/${encodeURIComponent(series.name)}`}
            class="series-card"
            style={`--series-h: ${seriesHue(series.name)};`}
          >
            <div class="series-card-band">
              <h2 class="series-card-name">{series.name}</h2>
              <span class="series-card-count">{series.count}</span>
            </div>

            <div class="series-card-meta">
              <span class="series-card-label">更新</span>
              <time datetime={series.lastUpdated.toISOString()}>
                {formatDate.format(series.lastUpdated)}
              </time>
              <span aria-hidden="true">·</span>
              <span>{series.count} 篇</span>
            </div>

            {series.blurb && <p class="series-card-blurb">{series.blurb}</p>}

            <ol class="series-card-lessons">
              {series.posts.slice(0, 3).map((post, i) => (
                <li>
                  <span class="series-card-step">{i + 1}</span>
                  <span class="series-card-lesson">{post.data.title}</span>
                </li>
              ))}
              {series.count > 3 && (
                <li class="series-card-more">还有 {series.count - 3} 篇</li>
              )}
            </ol>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .series-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .series-card {
    display: block;
    text-decoration: none;
    padding: 0 0 1.125rem;
    border-bottom: 1px dashed hsl(var(--line));
  }

  .series-card:last-child {
    border-bottom: none;
  }

  /* Same tinted band as a post row, so a series and its articles read as one
     object wherever they appear. */
  .series-card-band {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.75rem;
    background-color: hsl(var(--series-h) 58% 24%);
    border-radius: var(--radius);
    transition: filter 0.15s;
  }

  .series-card:hover .series-card-band {
    filter: brightness(1.08);
  }

  .series-card-name {
    margin: 0;
    min-width: 0;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.4;
    color: #fff;
  }

  @media (min-width: 768px) {
    .series-card-name {
      font-size: 1.125rem;
    }
  }

  .series-card-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.75);
    white-space: nowrap;
  }

  .series-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.25rem;
    padding: 0.375rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: hsl(var(--fg-muted));
    background-color: hsl(var(--bg-subtle) / 0.6);
    border-radius: var(--radius);
  }

  .series-card-label {
    font-family: var(--font-sans);
    font-weight: 500;
    color: hsl(var(--fg-faint));
  }

  .series-card-blurb {
    margin: 0.625rem 0 0;
    padding: 0 0.75rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: hsl(var(--fg-muted));
  }

  .series-card-lessons {
    margin: 0.625rem 0 0;
    padding: 0 0.75rem;
    list-style: none;
  }

  .series-card-lessons li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: hsl(var(--fg-muted));
    padding: 0.125rem 0;
  }

  .series-card-step {
    flex-shrink: 0;
    width: 1.125rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: hsl(var(--fg-faint));
  }

  .series-card-lesson {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .series-card-more {
    font-size: 0.75rem;
    color: hsl(var(--fg-faint));
  }

  .series-empty {
    padding: 4rem 0;
    text-align: center;
    color: hsl(var(--fg-muted));
  }
</style>