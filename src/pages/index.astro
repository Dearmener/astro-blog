---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const htmlPostsRaw = await getCollection('htmlPosts', ({ data }) => !data.draft);
const posts = [...blogPosts, ...htmlPostsRaw]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Separate series posts from regular posts
const seriesMap = new Map<string, typeof posts>();
const regularPosts: typeof posts = [];

posts.forEach((post) => {
  if (post.data.series) {
    const existing = seriesMap.get(post.data.series) || [];
    existing.push(post);
    seriesMap.set(post.data.series, existing);
  } else {
    regularPosts.push(post);
  }
});

// Get series list with metadata
const seriesList = Array.from(seriesMap.entries())
  .map(([name, seriesPosts]) => {
    const sortedPosts = seriesPosts.sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0));
    return {
      name,
      posts: sortedPosts,
      count: sortedPosts.length,
      firstPost: sortedPosts[0],
      lastUpdated: seriesPosts.reduce((latest, p) => p.data.pubDate > latest ? p.data.pubDate : latest, seriesPosts[0].data.pubDate),
    };
  })
  .sort((a, b) => b.lastUpdated.getTime() - a.lastUpdated.getTime());

const recentPosts = regularPosts.slice(0, 5);

// Format date helper
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('zh-CN', {
    month: 'short',
    day: 'numeric',
  }).format(date);
};
---

<BaseLayout title="首页 | 孟国庆的博客">
  <div class="home-container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-brand">
        <span class="hero-avatar">孟</span>
        <div class="hero-text">
          <h1 class="hero-title">孟国庆的博客</h1>
          <p class="hero-desc">记录技术 · 分享生活 · 探索 AI</p>
        </div>
      </div>
    </section>

    <!-- Series Section -->
    {seriesList.length > 0 && (
      <section class="content-section">
        <div class="section-header">
          <h2 class="section-title">系列教程</h2>
          <a href="/series" class="section-link">全部系列 →</a>
        </div>
        
        <div class="series-grid">
          {seriesList.slice(0, 4).map((series) => (
            <a href={`/series/${encodeURIComponent(series.name)}`} class="series-card">
              <div class="series-card-content">
                <h3 class="series-card-title">{series.name}</h3>
                <p class="series-card-meta">{series.count} 篇文章</p>
                {series.firstPost.data.description && (
                  <p class="series-card-desc">{series.firstPost.data.description}</p>
                )}
              </div>
              <div class="series-card-footer">
                <span class="series-progress">{series.count} 篇</span>
                <span class="series-date">更新于 {formatDate(series.lastUpdated)}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Posts Section -->
    <section class="content-section">
      <div class="section-header">
        <h2 class="section-title">最新文章</h2>
        <a href="/blog" class="section-link">全部文章 →</a>
      </div>
      
      <div class="posts-list">
        {recentPosts.map((post) => (
          <a href={`/blog/${post.id}`} class="post-item">
            <div class="post-thumb">
              {post.data.heroImage ? (
                <img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
              ) : (
                <div class="post-thumb-placeholder">
                  <span>{post.data.title.slice(0, 2)}</span>
                </div>
              )}
            </div>
            <div class="post-content">
              <div class="post-header">
                <h3 class="post-title">{post.data.title}</h3>
                <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </div>
              {post.data.description && (
                <p class="post-desc">{post.data.description}</p>
              )}
              <div class="post-footer">
                {post.data.category && (
                  <span class="post-category">{post.data.category}</span>
                )}
                {post.data.tags && post.data.tags.slice(0, 3).map((tag, i) => (
                  <span class={`post-tag tag-${i % 6}`}>{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Quick Links -->
    <section class="content-section">
      <div class="section-header">
        <h2 class="section-title">浏览</h2>
      </div>
      
      <div class="quick-links">
        <a href="/categories" class="quick-link">
          <span class="quick-link-title">分类</span>
          <span class="quick-link-arrow">→</span>
        </a>
        <a href="/tags" class="quick-link">
          <span class="quick-link-title">标签</span>
          <span class="quick-link-arrow">→</span>
        </a>
        <a href="/about" class="quick-link">
          <span class="quick-link-title">关于</span>
          <span class="quick-link-arrow">→</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  /* Hero */
  .hero {
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid var(--notion-border);
    margin-bottom: 2.5rem;
  }

  .hero-brand {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    font-size: 1.75rem;
    font-weight: 700;
    border-radius: 1rem;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(102, 126, 234, 0.25);
  }

  :global(.dark) .hero-avatar {
    background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.3);
  }

  .hero-text {
    flex: 1;
  }

  .hero-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--notion-text);
    margin: 0 0 0.375rem 0;
    letter-spacing: -0.02em;
  }

  .hero-desc {
    font-size: 0.9375rem;
    color: var(--notion-text-secondary);
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* Section */
  .content-section {
    margin-bottom: 3rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--notion-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .section-link {
    font-size: 0.8125rem;
    color: var(--notion-text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .section-link:hover {
    color: var(--notion-text);
  }

  /* Series Grid */
  .series-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .series-grid {
      grid-template-columns: 1fr;
    }
  }

  .series-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background-color: var(--notion-bg);
    border: 1px solid var(--notion-border);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .series-card:hover {
    border-color: var(--notion-text-secondary);
    transform: translateY(-1px);
  }

  .series-card-content {
    flex: 1;
  }

  .series-card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--notion-text);
    margin: 0 0 0.25rem 0;
    line-height: 1.4;
  }

  .series-card-meta {
    font-size: 0.75rem;
    color: var(--notion-text-secondary);
    margin: 0 0 0.75rem 0;
  }

  .series-card-desc {
    font-size: 0.875rem;
    color: var(--notion-text-secondary);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .series-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--notion-border);
    font-size: 0.75rem;
    color: var(--notion-text-secondary);
  }

  .series-progress {
    background-color: var(--notion-bg-secondary);
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
  }

  /* Posts List */
  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .post-item {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    text-decoration: none;
    border-bottom: 1px solid var(--notion-border);
    transition: background-color 0.1s;
  }

  .post-item:first-child {
    padding-top: 0;
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-item:hover {
    background-color: var(--notion-bg-hover);
    margin: 0 -1rem;
    padding-left: 1rem;
    padding-right: 1rem;
    border-radius: 6px;
    border-bottom-color: transparent;
  }

  .post-thumb {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 6px;
    overflow: hidden;
    background-color: var(--notion-bg-secondary);
  }

  .post-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--notion-text-secondary);
    background: linear-gradient(135deg, var(--notion-bg-secondary) 0%, var(--notion-bg-hover) 100%);
  }

  .post-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .post-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.375rem;
  }

  .post-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--notion-text);
    margin: 0;
    line-height: 1.4;
    flex: 1;
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--notion-text-secondary);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .post-desc {
    font-size: 0.875rem;
    color: var(--notion-text-secondary);
    margin: 0 0 0.5rem 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }

  .post-category {
    font-size: 0.6875rem;
    color: var(--notion-text-secondary);
    background-color: var(--notion-bg-secondary);
    padding: 0.125rem 0.5rem;
    border-radius: 3px;
  }

  .post-tag {
    font-size: 0.6875rem;
    padding: 0.125rem 0.5rem;
    border-radius: 3px;
  }

  .tag-0 { background-color: rgba(46, 170, 220, 0.15); color: #2eaadc; }
  .tag-1 { background-color: rgba(155, 89, 182, 0.15); color: #9b59b6; }
  .tag-2 { background-color: rgba(46, 204, 113, 0.15); color: #27ae60; }
  .tag-3 { background-color: rgba(241, 196, 15, 0.2); color: #d4a017; }
  .tag-4 { background-color: rgba(230, 126, 34, 0.15); color: #e67e22; }
  .tag-5 { background-color: rgba(231, 76, 60, 0.15); color: #e74c3c; }

  :global(.dark) .tag-0 { background-color: rgba(46, 170, 220, 0.2); color: #5dbce8; }
  :global(.dark) .tag-1 { background-color: rgba(155, 89, 182, 0.2); color: #bb8fce; }
  :global(.dark) .tag-2 { background-color: rgba(46, 204, 113, 0.2); color: #58d68d; }
  :global(.dark) .tag-3 { background-color: rgba(241, 196, 15, 0.2); color: #f4d03f; }
  :global(.dark) .tag-4 { background-color: rgba(230, 126, 34, 0.2); color: #f0a556; }
  :global(.dark) .tag-5 { background-color: rgba(231, 76, 60, 0.2); color: #f1948a; }

  /* Quick Links */
  .quick-links {
    display: flex;
    gap: 0.5rem;
  }

  .quick-link {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.875rem 1rem;
    background-color: var(--notion-bg-secondary);
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .quick-link:hover {
    background-color: var(--notion-bg-hover);
  }

  .quick-link-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--notion-text);
  }

  .quick-link-arrow {
    font-size: 0.875rem;
    color: var(--notion-text-secondary);
  }

  /* Responsive */
  @media (max-width: 480px) {
    .post-thumb {
      width: 60px;
      height: 60px;
    }

    .post-header {
      flex-direction: column;
      gap: 0.25rem;
    }

    .quick-links {
      flex-direction: column;
    }
  }
</style>
