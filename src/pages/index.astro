---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Separate series posts from regular posts
const seriesMap = new Map<string, typeof posts>();
const regularPosts: typeof posts = [];

posts.forEach((post) => {
  if (post.data.series) {
    const existing = seriesMap.get(post.data.series) || [];
    existing.push(post);
    seriesMap.set(post.data.series, existing);
  } else {
    regularPosts.push(post);
  }
});

// Get series list with metadata
const seriesList = Array.from(seriesMap.entries())
  .map(([name, seriesPosts]) => {
    const sortedPosts = seriesPosts.sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0));
    return {
      name,
      posts: sortedPosts,
      count: sortedPosts.length,
      firstPost: sortedPosts[0],
      lastUpdated: seriesPosts.reduce((latest, p) => p.data.pubDate > latest ? p.data.pubDate : latest, seriesPosts[0].data.pubDate),
    };
  })
  .sort((a, b) => b.lastUpdated.getTime() - a.lastUpdated.getTime());

const recentPosts = regularPosts.slice(0, 5);

// Format date helper
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('zh-CN', {
    month: 'short',
    day: 'numeric',
  }).format(date);
};
---

<BaseLayout title="首页 | 孟国庆的博客">
  <div class="home-container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-brand">
        <span class="hero-avatar">孟</span>
        <div class="hero-text">
          <h1 class="hero-title">孟国庆的博客</h1>
        </div>
      </div>
    </section>

    <!-- Series Section -->
    {seriesList.length > 0 && (
      <section class="content-section">
        <div class="section-header">
          <h2 class="section-title">系列教程</h2>
          <a href="/series" class="section-link">全部系列 →</a>
        </div>
        
        <div class="series-grid">
          {seriesList.slice(0, 4).map((series) => (
            <a href={`/series/${encodeURIComponent(series.name)}`} class="series-card">
              <div class="series-card-content">
                <h3 class="series-card-title">{series.name}</h3>
                <p class="series-card-meta">{series.count} 篇文章</p>
                {series.firstPost.data.description && (
                  <p class="series-card-desc">{series.firstPost.data.description}</p>
                )}
              </div>
              <div class="series-card-footer">
                <span class="series-progress">{series.count} 篇</span>
                <span class="series-date">更新于 {formatDate(series.lastUpdated)}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Posts Section -->
    <section class="content-section">
      <div class="section-header">
        <h2 class="section-title">最新文章</h2>
        <a href="/blog" class="section-link">全部文章 →</a>
      </div>

      <div class="picks">
        {recentPosts.map((post) => <PostRow post={post} />)}
      </div>
    </section>

    <!-- Quick Links -->
    <section class="content-section">
      <div class="section-header">
        <h2 class="section-title">浏览</h2>
      </div>
      
      <div class="quick-links">
        <a href="/categories" class="quick-link">
          <span class="quick-link-title">分类</span>
          <span class="quick-link-arrow">→</span>
        </a>
        <a href="/tags" class="quick-link">
          <span class="quick-link-title">标签</span>
          <span class="quick-link-arrow">→</span>
        </a>
        <a href="/about" class="quick-link">
          <span class="quick-link-title">关于</span>
          <span class="quick-link-arrow">→</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-container {
    max-width: var(--page);
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  /* Hero */
  .hero {
    padding: 2rem 0 1.5rem;
    border-bottom: 1px solid hsl(var(--line));
    margin-bottom: 2.5rem;
  }

  .hero-brand {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    background: hsl(var(--brand));
    color: hsl(var(--bg));
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 700;
    border-radius: var(--radius);
    flex-shrink: 0;
  }

  .hero-text {
    flex: 1;
  }

  .hero-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: hsl(var(--fg));
    margin: 0 0 0.375rem 0;
    letter-spacing: -0.02em;
  }


  /* Section */
  .content-section {
    margin-bottom: 3rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid hsl(var(--brand));
  }

  .section-title {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: hsl(var(--fg-muted));
    margin: 0;
  }

  .section-link {
    font-size: 0.8125rem;
    color: hsl(var(--fg-muted));
    text-decoration: none;
    transition: color 0.15s;
  }

  .section-link:hover {
    color: hsl(var(--fg));
  }

  /* Series Grid */
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1rem;
  }

  .series-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background-color: hsl(var(--bg));
    border: 1px solid hsl(var(--line));
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .series-card:hover {
    border-color: hsl(var(--fg-muted));
    transform: translateY(-1px);
  }

  .series-card-content {
    flex: 1;
  }

  .series-card-title {
    font-size: 1rem;
    font-weight: 600;
    color: hsl(var(--fg));
    margin: 0 0 0.25rem 0;
    line-height: 1.4;
  }

  .series-card-meta {
    font-size: 0.75rem;
    color: hsl(var(--fg-muted));
    margin: 0 0 0.75rem 0;
  }

  .series-card-desc {
    font-size: 0.875rem;
    color: hsl(var(--fg-muted));
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .series-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid hsl(var(--line));
    font-size: 0.75rem;
    color: hsl(var(--fg-muted));
  }

  .series-progress {
    background-color: hsl(var(--bg-subtle));
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
  }

  /* Quick Links */
  .quick-links {
    display: flex;
    gap: 0.5rem;
  }

  .quick-link {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.875rem 1rem;
    background-color: hsl(var(--bg-subtle));
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .quick-link:hover {
    background-color: hsl(var(--bg-hover));
  }

  .quick-link-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--fg));
  }

  .quick-link-arrow {
    font-size: 0.875rem;
    color: hsl(var(--fg-muted));
  }

  /* Responsive */
  @media (max-width: 480px) {
    .quick-links {
      flex-direction: column;
    }
  }
</style>
